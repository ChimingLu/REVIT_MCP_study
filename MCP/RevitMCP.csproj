<Project Sdk="Nice3point.Revit.Sdk/6.1.0">

  <PropertyGroup>
    <RootNamespace>RevitMCP</RootNamespace>
    <AssemblyName>RevitMCP</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <!-- DeployAddin 關閉：避免 SDK 自動產生 RevitMCP.{version}.addin 造成重複載入 -->
    <!-- 部署請使用 setup.ps1 或 /deploy-addon skill -->
    <DeployAddin>false</DeployAddin>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Configurations>
      Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26;
      Release.R22;Release.R23;Release.R24;Release.R25;Release.R26
    </Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\icon-32-on.png" />
    <Resource Include="Resources\icon-32-off.png" />
  </ItemGroup>

  <!-- 熱重載（opt-in，移植自 feature/core-reload-patch）：Loader 只依賴 MCP.Contracts，
       WebSocket 服務與命令分派在 runtime\RevitMCP.CoreRuntime.dll，可用 ribbon「Core 重載」換新。 -->
  <ItemGroup>
    <ProjectReference Include="..\MCP.Contracts\MCP.Contracts.csproj" />
  </ItemGroup>

  <Target Name="BuildCoreRuntime" BeforeTargets="Build">
    <MSBuild
      Projects="..\MCP.CoreRuntime\MCP.CoreRuntime.csproj"
      Targets="Restore;Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CopyCoreRuntimeArtifacts" AfterTargets="Build">
    <ItemGroup>
      <!-- CoreRuntime 與它的相依 DLL（ClosedXML 等）一起放進 runtime\，熱重載的 shadow-copy 才解析得到 -->
      <CoreRuntimeArtifacts Include="..\MCP.CoreRuntime\bin\$(Configuration)\**\*.dll"
                            Exclude="..\MCP.CoreRuntime\bin\$(Configuration)\**\MCP.Contracts.dll" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)runtime" />
    <!-- MCP.Contracts.dll 必須只留在 Loader 目錄：runtime\ 內若有一份，會載成不同型別而轉型失敗 -->
    <Delete Files="$(OutDir)runtime\MCP.Contracts.dll" ContinueOnError="true" />
    <Copy SourceFiles="@(CoreRuntimeArtifacts)" DestinationFolder="$(OutDir)runtime" SkipUnchangedFiles="true" />
  </Target>

</Project>
