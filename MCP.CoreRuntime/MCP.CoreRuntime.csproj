<Project Sdk="Nice3point.Revit.Sdk/6.1.0">

  <PropertyGroup>
    <RootNamespace>RevitMCP</RootNamespace>
    <AssemblyName>RevitMCP.CoreRuntime</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <DeployAddin>false</DeployAddin>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Configurations>
      Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26;
      Release.R22;Release.R23;Release.R24;Release.R25;Release.R26
    </Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCP.Contracts\MCP.Contracts.csproj" />
  </ItemGroup>

  <!--
    The runtime compiles the same sources as the loader (glob, never a hand-typed list,
    so new command files are picked up automatically), minus the loader-only pieces:
    the IExternalApplication entry point, ribbon commands, and the runtime manager itself.
  -->
  <ItemGroup>
    <Compile Include="..\MCP\**\*.cs"
             Exclude="..\MCP\obj\**;..\MCP\bin\**;..\MCP\Application.cs;..\MCP\Commands\**;..\MCP\Core\CoreRuntimeManager.cs;..\MCP\Core\CoreLoadContext.cs"
             LinkBase="MCP" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\MCP\Resources\icon-32-on.png" Link="Resources\icon-32-on.png" />
    <Resource Include="..\MCP\Resources\icon-32-off.png" Link="Resources\icon-32-off.png" />
  </ItemGroup>

</Project>
