<Project Sdk="Nice3point.Revit.Sdk/6.1.0">

  <PropertyGroup>
    <RootNamespace>RevitMCP</RootNamespace>
    <AssemblyName>RevitMCP.CoreRuntime</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <DeployAddin>false</DeployAddin>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Configurations>
      Debug.R20;Debug.R21;Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26;
      Release.R20;Release.R21;Release.R22;Release.R23;Release.R24;Release.R25;Release.R26
    </Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCP.Contracts\MCP.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MCP\Configuration\*.cs" Link="Configuration\%(Filename)%(Extension)" />
    <Compile Include="..\MCP\Core\*.cs" Exclude="..\MCP\Core\CoreLoadContext.cs;..\MCP\Core\CoreRuntimeManager.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\MCP\Core\Commands\*.cs" Link="Core\Commands\%(Filename)%(Extension)" />
    <Compile Include="..\MCP\Core\Grading\*.cs" Link="Core\Grading\%(Filename)%(Extension)" />
    <Compile Include="..\MCP\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
