<Project Sdk="Nice3point.Revit.Sdk/6.1.0">

  <PropertyGroup>
    <RootNamespace>RevitMCP</RootNamespace>
    <AssemblyName>RevitMCP.CoreRuntime</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <DeployAddin>false</DeployAddin>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DefineConstants>$(DefineConstants);CORE_RUNTIME_BUILD</DefineConstants>
    <Configurations>
      Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27;
      Release.R22;Release.R23;Release.R24;Release.R25;Release.R26;Release.R27
    </Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCP.Contracts\MCP.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MCP\Configuration\*.cs" LinkBase="Configuration" />
    <Compile Include="..\MCP\Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\MCP\Models\*.cs" LinkBase="Models" />
    <Compile Include="..\MCP\UI\*.cs" LinkBase="UI" />
  </ItemGroup>

</Project>
